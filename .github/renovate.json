{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "nix": {
    "enabled": true
  },
  "automerge": true,
  "platformAutomerge": false,
  "dependencyDashboard": false,
  "gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
  "labels": ["dependencies", "renovate"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Peer ranges describe what consumers may use; widen them instead of raising the floor.",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "description": "vite-plus and the vite alias to vite-plus-core must move together, or two Vite type trees meet in one config.",
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "Vite+"
    }
  ]
}
